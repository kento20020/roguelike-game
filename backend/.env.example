# カジノタワー ローグライト — backend 環境変数（OPEN-027）
# コピーして .env を作るか、シェルで export して使う（.env は git 管理外）。

# SQLite の既定は backend/game.db。PostgreSQL 移行時はここを差し替えるだけ（app/db/session.py）。
# DATABASE_URL=sqlite:///C:/path/to/game.db

# CORS 許可オリジン（カンマ区切り）。既定は Vite dev server のみ。
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ログレベル（DEBUG/INFO/WARNING/ERROR）。既定 INFO。
# LOG_LEVEL=INFO

# ログ出力形式。既定 text（従来のプレーンテキスト・ローカル開発の可読性重視）。
# json を指定すると 1 行構造化 JSON（ts/level/logger/msg/request_id/exc）に切り替わる。
# ログ集約基盤へ流す場合や request_id で機械的にフィルタしたい場合に json を使う。
# LOG_FORMAT=text

# active_sessions（進行中ラン）の TTL。この時間を超えて更新されていない行を掃除する。
# 既定 168（＝7日・crud.delete_stale_active_sessions の既定と一致）。
# SESSION_TTL_HOURS=168

# TTL 掃除タスクの実行間隔（時間）。起動直後に1回実行し、以降この間隔で繰り返す。既定 24。
# SESSION_CLEANUP_INTERVAL_HOURS=24
