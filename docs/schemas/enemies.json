    "behaviors": "[{type, weight}] 合計100。カオスはchaos:trueで空",
    "ramp_increment": "int (レース系のみ)",
    "chaos": "bool (カオス系のみtrue)",
    "gold_base": "int",
    "heavy_factor": "float (任意上書き。無ければconfig既定1.8)"
  },

