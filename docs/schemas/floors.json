    "unhurt": 0.0,
    "minor": 0.10,
    "major": 0.25,
    "special": 0.0,
    "_comment": "minor/majorはmax_hpに対する割合。specialは無傷+次フロア強化等。"
  },

  "gate_guarantee_rule": {
    "_comment": "n回目: コスト=50*1.5^(n-1)、大ダメ削減=0.25*0.5^(n-1)。削減分は無傷・小ダメへ半々(split 0.5/0.5)。特殊は維持。重ねがけ可。",
    "split_to_unhurt": 0.5,
    "split_to_minor": 0.5,
    "preserve_special": true
