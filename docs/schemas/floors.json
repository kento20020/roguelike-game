{
  "_comment": "5フロア構成。テーマ=カジノタワーを登り詰める。描画は下から上（row1が画面下、gateが画面上）。データ構造はrow1→row2→gateの順で進行。アンロックはハイブリッド型（多親=隣接2体/単親=1体）。",

  "_render_direction": {
    "vertical": "bottom_to_top",
    "_comment": "row1を画面下に、ゲートを画面上に描画。TreeCanvasでy座標を反転。ロジックには影響しない。"
  },

  "_unlock_pattern": {
    "type": "hybrid",
    "multi_parent": "隣接2体の上位ノードから解放（ゲートルート）",
    "single_parent": "1体のみから解放（dead-end・宝箱/回復のみ）"
  },

  "floors": [
    {
      "floor_number": 1, "name": "1F チュートリアル", "tree_shape": [3, 3],
      "fixed_layout": true,
      "row1_pool": ["f1_fixed_a", "f1_fixed_b", "f1_fixed_c"],
      "row2_pool": [],
